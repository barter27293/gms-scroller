{
  "name": "gms-scroller",
  "version": "0.2.0",
  "description": "Electron desktop app that embeds the GMS audio website and auto-scrolls a PDF transcript using real-time speech-to-text.",
  "main": "main.js",
  "private": true,
  "author": "Kieran Barter",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:icon": "node scripts/make-icon.js",
    "build:icon:placeholder": "node scripts/make-icon.js --generate"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "fuse.js": "^7.0.0",
    "pdfjs-dist": "^3.11.174"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.1",
    "pngjs": "^7.0.0"
  },
  "build": {
    "appId": "com.kieran.gmsscroller",
    "productName": "GMS Scroller",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "python/**/*",
      "build/icon.*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "python",
        "to": "python"
      }
    ]
  }
}
