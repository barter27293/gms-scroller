{
  "name": "gms-scroller",
  "version": "0.4.0",
  "description": "Desktop app that embeds the GMS audio website and auto-scrolls a PDF transcript using real-time speech-to-text.",
  "main": "main.js",
  "private": true,
  "author": "Kieran Barter",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/barter27293/gms-scroller.git"
  },
  "scripts": {
    "start": "electron .",
    "fetch-vendor": "node scripts/fetch-vendor.mjs",
    "prebuild": "node scripts/fetch-vendor.mjs",
    "build": "electron-builder --win",
    "prerelease": "node scripts/fetch-vendor.mjs",
    "release": "electron-builder --win --publish always",
    "build:icon": "node scripts/make-icon.js",
    "build:icon:placeholder": "node scripts/make-icon.js --generate"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "fuse.js": "^7.0.0",
    "pdfjs-dist": "^3.11.174"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.1",
    "pngjs": "^7.0.0"
  },
  "build": {
    "appId": "com.kieran.gmsscroller",
    "productName": "GMS Scroller",
    "publish": [
      {
        "provider": "github",
        "owner": "barter27293",
        "repo": "gms-scroller",
        "releaseType": "draft"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "include": "build/installer.nsh"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "python/**/*",
      "build/icon.*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "python",
        "to": "python"
      },
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg"
      },
      {
        "from": "vendor/python",
        "to": "python-runtime"
      },
      {
        "from": "vendor/setup-screen-capturer-recorder.exe",
        "to": "setup-screen-capturer-recorder.exe"
      }
    ]
  }
}
